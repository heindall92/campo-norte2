# Campo Norte WMS / Proyecto Almacén
# Copia a .env.development.local (gitignored). No uses el proyecto CRM 30mps.

# local | supabase  (con URL+KEY, el Hub usa Postgres)
VITE_DATA_MODE=supabase

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# En Supabase Auth: crea usuarios del equipo (sofia@camponorte.demo, marta@…)
# El rol de autorización se lee de mps_profiles / wms_user_roles.
# NUNCA se toma de user_metadata.role (el cliente no puede auto-promocionarse).
# Roles CRM: admin | booking | ops | guide | pending
# Roles WMS: ADMIN | WAREHOUSE_MANAGER | SUPERVISOR | RECEIVING | PICKER |
#            PACKER | SHIPPER | FORKLIFT_OPERATOR | INVENTORY_CONTROLLER |
#            AUDITOR | VIEWER

# --- WMS: demo vs producción ---
# Con VITE_SUPABASE_* el modo es production y el login demo se apaga solo.
# VITE_WMS_MODE=demo  → vuelve al snapshot local (solo si lo pides).
# VITE_WMS_MODE=production
# VITE_STRICT_AUTH=true
# VITE_ALLOW_DEMO_AUTH=false
#
# En production la UI habla WmsPort → RPCs wms_save_floor / wms_commit_stock.
# Stock vive en wms_handling_units + wms_inventory_transactions (append-only).
# Login sofia@camponorte.demo / provider=local nunca llama a esas RPCs.

# --- Seguridad demo vs producción ---
# Keys en el navegador: OFF en producción salvo:
# VITE_ALLOW_CLIENT_AI_KEYS=true
#
# Login demo (cuentas embebidas): se apaga con:
#   - VITE_STRICT_AUTH=true
#   - VITE_ALLOW_DEMO_AUTH=false
# Con Supabase configurado el fallback demo SIGUE activo salvo esos flags.
# En producción real hay que cerrarlo. Rotar pass:
# VITE_DEMO_PASSWORD=otra-clave

# --- Endurecimiento de los endpoints /api (server-side) ---
# Orígenes permitidos además del propio despliegue (coma-separados).
# Vercel ya añade VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL automáticamente.
# ALLOWED_ORIGINS=https://crm.example.com,https://example.com
#
# Peticiones/minuto por IP contra el proxy de IA (defecto 20).
# AI_RATE_LIMIT=20

# --- IA multi-proveedor (Fase 3–5 + Automatizaciones) ---
# La IA SOLO clasifica / prioriza / responde Knowledge interno. Nunca habla con el viajero.
# Proveedor activo (UI Ajustes): ollama | openai | claude | gemini

# Ollama (https://ollama.com/settings) — cloud | local
VITE_OLLAMA_MODE=cloud
VITE_OLLAMA_BASE_URL=https://ollama.com
VITE_OLLAMA_MODEL=llama3.2

# Keys en el SERVIDOR (Vercel / api/ai/chat) — preferido en producción:
# OLLAMA_API_KEY=ollama_sk_...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...

# Keys VITE_* solo para el proxy de desarrollo local (nunca en prod):
# VITE_OLLAMA_API_KEY=ollama_sk_...
# VITE_OPENAI_API_KEY=sk-...
# VITE_ANTHROPIC_API_KEY=sk-ant-...
# VITE_GEMINI_API_KEY=AIza...
# VITE_OPENAI_MODEL=gpt-4o-mini
# VITE_CLAUDE_MODEL=claude-sonnet-4-20250514
# VITE_GEMINI_MODEL=gemini-2.0-flash

# ALLOW_CLIENT_AI_KEYS=true  # solo si el serverless debe aceptar body.apiKey (no recomendado en prod)

# ---------------------------------------------------------------------------
# Lazo cerrado de leads (funciones de servidor en api/)
#
# Estas NO llevan el prefijo VITE_: son de servidor y nunca llegan al navegador.
# ---------------------------------------------------------------------------

# Data Hub server-side. La service role key se salta la RLS a propósito para que
# la ingesta pueda escribir sin sesión: NUNCA la pongas en una variable VITE_.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Misma key sirve para la bitácora de accesos (analítica gratis):
# /api/auth/access-log → tabla mps_access_log (ver supabase/access-log.sql)

# Clave para integraciones externas que envían leads (formulario de example.com,
# n8n, Make). Genera una larga y aleatoria: openssl rand -hex 32
LEADS_INGEST_SECRET=

# Secreto del reloj (/api/cron/rescore). Vercel Cron lo manda como
# "Authorization: Bearer <CRON_SECRET>"; cualquier otro reloj puede usar x-mps-key.
CRON_SECRET=

# Orígenes permitidos para el formulario público de la app (además de los
# dominios de Vercel, que se detectan solos). Separados por comas.
ALLOWED_ORIGINS=

# Peticiones por minuto y por IP en la ingesta (por defecto 12)
INGEST_RATE_LIMIT=12
